        "exec": [
          "if (!pm.environment.get(\"runId\")) {",
          "  const runId = Date.now().toString();",
          "  pm.environment.set(\"runId\", runId);",
          "  pm.environment.set(\"userA\", \"qa_user_a_\" + runId);",
          "  pm.environment.set(\"userB\", \"qa_user_b_\" + runId);",
          "  pm.environment.set(\"passA\", \"TempA!\" + runId);",
          "  pm.environment.set(\"passB\", \"TempB!\" + runId);",
          "}"
        ]
      }
    }
