    {
      "name": "TC-001 Register valid user A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{userA}}\",\"password\":\"{{passA}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString() + \"_\" + Math.floor(Math.random()*100000);",
              "pm.environment.set(\"runId\", runId);",
              "pm.environment.set(\"userA\", \"qa_user_a_\" + runId);",
              "pm.environment.set(\"userB\", \"qa_user_b_\" + runId);",
              "pm.environment.set(\"passA\", \"TempA!\" + runId);",
              "pm.environment.set(\"passB\", \"TempB!\" + runId);",
              "[\"tokenA\",\"tokenB\",\"userAId\",\"userBId\",\"orderAId\",\"confirmedAtFirst\"].forEach(k => pm.environment.unset(k));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "",
              "pm.test(\"TC-001 status 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"TC-001 auth response fields\", () => {",
              "  pm.expect(body).to.have.property(\"accessToken\").that.is.a(\"string\");",
              "  pm.expect(body.tokenType).to.eql(\"Bearer\");",
              "  pm.expect(body.user.username).to.eql(pm.environment.get(\"userA\"));",
              "});",
              "pm.environment.set(\"tokenA\", body.accessToken);",
              "pm.environment.set(\"userAId\", body.user.id);"
            ]
          }
        }
      ]
    },
